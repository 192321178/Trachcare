<?xml version="1.0" encoding="utf-8"?>
<!-- The Trachcare PHP backend is served over plain HTTP on the XAMPP box, and
     Android blocks cleartext by default from API 28 up. Cleartext is allowed
     only for the hosts the app actually talks to; add a <domain> here whenever
     API_BASE points somewhere new. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">180.235.121.245</domain>
        <domain includeSubdomains="false">172.20.10.4</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
